<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CareConnect.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CareConnect.Mobile.Views.Auth"
    Shell.NavBarIsVisible="False" 
    NavigationPage.HasNavigationBar="False"
    FlyoutBehavior="Disabled">

    <ShellContent
        Route="LoginView"
        ContentTemplate="{DataTemplate views:LoginView}" />

    <ShellContent
        Route="ProfileSelectionView"
        ContentTemplate="{DataTemplate views:ProfileSelectionView}" 
        FlyoutItemIsVisible="False"/>

    <ShellContent
        Route="OnboardingView"
        ContentTemplate="{DataTemplate views:OnboardingView}" 
        FlyoutItemIsVisible="False"/>

</Shell>