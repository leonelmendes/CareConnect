<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CareConnect.Mobile.Views.Auth.ProfileSelectionView"
             Title="ProfileSelectionView"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25">
            
            <Grid ColumnDefinitions="40,*,40,*,40" ColumnSpacing="0" Margin="0, 10, 0, 10">
                <Ellipse Grid.Column="0" WidthRequest="32" HeightRequest="32" Fill="#E3F2FD" Stroke="{StaticResource Primary}" StrokeThickness="1.5" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Image Grid.Column="0" Source="icon_correct_blue" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                <BoxView Grid.Column="1" HeightRequest="2" Color="{StaticResource Primary}" VerticalOptions="Center" Margin="-2,0"/>
                <Ellipse Grid.Column="2" WidthRequest="32" HeightRequest="32" Fill="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Label Grid.Column="2" Text="2" FontFamily="InterBold" FontSize="14" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                <BoxView Grid.Column="3" HeightRequest="2" Color="#E0E0E0" VerticalOptions="Center" Margin="-2,0"/>
                <Ellipse Grid.Column="4" WidthRequest="32" HeightRequest="32" Fill="White" Stroke="#E0E0E0" StrokeThickness="1" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Label Grid.Column="4" Text="3" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource SecondaryText}" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Image Source="logo_careconnect" HeightRequest="36" />
                <Label Text="CareConnect" FontFamily="InterBold" FontSize="24" TextColor="#1A1A1A" FontAttributes="Bold" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="10" Margin="0, 10">
                <Label Text="Como vai usar a app?" FontFamily="InterBold" FontSize="26" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalOptions="Center"/>
                <Label Text="Selecione o perfil que melhor descreve a sua função." FontFamily="InterRegular" FontSize="15" TextColor="{StaticResource SecondaryText}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="20">
                
                <Border x:Name="CardGestor" Stroke="#E0E0E0" StrokeShape="RoundRectangle 12" StrokeThickness="2" BackgroundColor="White" Padding="20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGestorTapped"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <Image x:Name="CheckGestor" Source="icon_gestor_option" HeightRequest="20" WidthRequest="20" HorizontalOptions="End" VerticalOptions="Start" IsVisible="False"/>
                        <Grid ColumnDefinitions="Auto, *" Margin="0,10,0,0">
                            <Image Grid.Column="0" Source="icon_gestor_option" HeightRequest="50" WidthRequest="50" VerticalOptions="Start" Margin="0,0,20,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Gestor / Familiar" FontFamily="InterSemiBold" FontSize="17" TextColor="#1A1A1A" FontAttributes="Bold"/>
                                <Label Text="Quero registrar pacientes e definir planos de cuidados." FontFamily="InterRegular" FontSize="14" TextColor="{StaticResource SecondaryText}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="CardCuidador" Stroke="#E0E0E0" StrokeShape="RoundRectangle 12" StrokeThickness="2" BackgroundColor="White" Padding="20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCuidadorTapped"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <Image x:Name="CheckCuidador" Source="icon_cuidador_option" HeightRequest="20" WidthRequest="20" HorizontalOptions="End" VerticalOptions="Start" IsVisible="False"/>
                        <Grid ColumnDefinitions="Auto, *" Margin="0,10,0,0">
                            <Image Grid.Column="0" Source="icon_cuidador_option" HeightRequest="50" WidthRequest="50" VerticalOptions="Start" Margin="0,0,20,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Cuidador / Profissional" FontFamily="InterSemiBold" FontSize="17" TextColor="#1A1A1A" FontAttributes="Bold"/>
                                <Label Text="Quero consultar a agenda e registrar as tarefas." FontFamily="InterRegular" FontSize="14" TextColor="{StaticResource SecondaryText}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

            </VerticalStackLayout>

            <Button Text="Continuar" 
                    BackgroundColor="{StaticResource Primary}" 
                    TextColor="White" 
                    FontFamily="InterSemiBold"
                    FontAttributes="Bold"
                    HeightRequest="50" 
                    CornerRadius="8" 
                    Margin="0, 30, 0, 0"
                    Command="{Binding ContinueCommand}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>