<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CareConnect.Mobile.Views.LoginView"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="30,50,30,30" Spacing="25">
            
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Image Source="logo_careconnect" 
                   HeightRequest="36" 
                   HorizontalOptions="Center" />
                <Label Text="CareConnect" 
                    FontFamily="Inter-Bold"
                    FontSize="24" 
                    FontAttributes="Bold" 
                    TextColor="#1A1A1A" 
                    VerticalOptions="Center"/>
            
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Bem-vindo(a) de volta"
                    FontFamily="Inter-SemiBold" 
                       FontSize="26" 
                       FontAttributes="Bold" 
                       TextColor="#1A1A1A"
                       HorizontalOptions="Center"/>
                <Label Text="Sign in to continue your care journey" 
                       FontSize="14" 
                       TextColor="#757575"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="15" Margin="0,20,0,0">
                
                <VerticalStackLayout Spacing="5">
                    <Label Text="Email" FontSize="12" TextColor="#1A1A1A" FontAttributes="Bold"/>
                    <Border Stroke="pink" StrokeThickness="1" BackgroundColor="White" Padding="15,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Entry Placeholder="Enter your email" 
                               Keyboard="Email" 
                               TextColor="#1A1A1A" 
                               PlaceholderColor="#BDBDBD"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Password" FontSize="12" TextColor="#1A1A1A" FontAttributes="Bold"/>
                    <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="15,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Entry Placeholder="Enter your password" 
                               IsPassword="True" 
                               TextColor="#1A1A1A" 
                               PlaceholderColor="#BDBDBD"/>
                    </Border>
                </VerticalStackLayout>

                <Label Text="Forgot password?" 
                       TextColor="#0056B3" 
                       FontSize="12" 
                       FontAttributes="Bold" 
                       HorizontalOptions="End"/>
            </VerticalStackLayout>

            <Button Text="Sign In" 
                    BackgroundColor="#0056B3" 
                    TextColor="White" 
                    CornerRadius="8" 
                    HeightRequest="50" 
                    FontAttributes="Bold"
                    Margin="0,10,0,0"/>

            <Grid ColumnDefinitions="*, Auto, *" Margin="0,10">
                <BoxView Grid.Column="0" HeightRequest="1" Color="#E0E0E0" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="or continue with" TextColor="#9E9E9E" FontSize="12" Margin="10,0"/>
                <BoxView Grid.Column="2" HeightRequest="1" Color="#E0E0E0" VerticalOptions="Center"/>
            </Grid>

            <VerticalStackLayout Spacing="10">
                <Button Text="Sign in with Google" 
                        BackgroundColor="White" 
                        TextColor="#1A1A1A" 
                        BorderColor="#E0E0E0" 
                        BorderWidth="1" 
                        CornerRadius="8" 
                        HeightRequest="50" 
                        FontAttributes="Bold"/>
                
                <Button Text="Sign in with Apple" 
                        BackgroundColor="White" 
                        TextColor="#1A1A1A" 
                        BorderColor="#E0E0E0" 
                        BorderWidth="1" 
                        CornerRadius="8" 
                        HeightRequest="50" 
                        FontAttributes="Bold"/>
            </VerticalStackLayout>

            <HorizontalStackLayout HorizontalOptions="Center" Margin="0,20,0,0">
                <Label Text="Don't have an account? " TextColor="#757575" FontSize="14"/>
                <Label Text="Sign up" TextColor="#0056B3" FontSize="14" FontAttributes="Bold"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>