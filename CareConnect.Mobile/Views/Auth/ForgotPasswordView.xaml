<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CareConnect.Mobile.Views.Auth.ForgotPasswordView"
             Title="ForgotPasswordView"
             NavigationPage.HasNavigationBar="False">

    <ScrollView HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="30,50,30,30" Spacing="25">
            
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Image Source="logo_careconnect" 
                       HeightRequest="36" 
                       HorizontalOptions="Center" />
                <Label Text="CareConnect" 
                       FontFamily="InterBold"
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="#1A1A1A" 
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="10" Margin="0, 20, 0, 10">
                <Label Text="Esqueceu a palavra-passe?" 
                       FontFamily="InterBold"
                       FontSize="24" 
                       FontAttributes="Bold"
                       TextColor="#1A1A1A" 
                       HorizontalOptions="Center"/>
                <Label Text="Insira o seu email associado à conta. Vamos enviar-lhe um link mágico para criar uma nova palavra-passe." 
                       FontFamily="InterRegular"
                       FontSize="14" 
                       TextColor="{StaticResource SecondaryText}" 
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Email" FontFamily="InterSemiBold" FontSize="14" TextColor="#1A1A1A" FontAttributes="Bold"/>
                <Border Stroke="{StaticResource StrokeEntry}" StrokeShape="RoundRectangle 8" StrokeThickness="1" BackgroundColor="White" Padding="15,0" HeightRequest="50">
                    <Entry x:Name="EmailEntry"
                           Placeholder="nome@example.com"
                           Keyboard="Email"
                           FontFamily="InterRegular"
                           TextColor="#1A1A1A" 
                           PlaceholderColor="{StaticResource SecondaryText}"
                           VerticalOptions="Center"/>
                </Border>
            </VerticalStackLayout>

            <Button Text="Enviar Link de Recuperação" 
                    BackgroundColor="{StaticResource Primary}" 
                    TextColor="White" 
                    FontFamily="InterSemiBold"
                    FontAttributes="Bold"
                    HeightRequest="50" 
                    CornerRadius="8" 
                    Margin="0, 10, 0, 0"
                    Clicked="OnSendLinkTapped"/>

            <HorizontalStackLayout HorizontalOptions="Center" Margin="0, 20, 0, 0">
                <Label Text="Voltar ao " FontFamily="InterRegular" FontSize="14" TextColor="{StaticResource SecondaryText}" VerticalOptions="Center"/>
                <Label Text="Login" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource Primary}" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackToLoginTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>