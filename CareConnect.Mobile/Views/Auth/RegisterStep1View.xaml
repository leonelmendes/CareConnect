<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:CareConnect.Mobile.Components"
             x:Class="CareConnect.Mobile.Views.Auth.RegisterStep1View"
             Title="RegisterStep1View"
             NavigationPage.HasNavigationBar="True">

    <ScrollView HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="20,40,20,30" Spacing="25">

            <components:BackButton />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Image Source="logo_careconnect" 
                       HeightRequest="36" 
                       HorizontalOptions="Center" />
                <Label Text="CareConnect" 
                       FontFamily="InterBold"
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="#1A1A1A" 
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Criar conta" 
                       FontFamily="InterBold"
                       FontSize="28" 
                       FontAttributes="Bold"
                       TextColor="#1A1A1A" 
                       HorizontalOptions="Center"/>
                <Label Text="Junte-se ao CareConnect em poucos segundos." 
                       FontFamily="InterRegular"
                       FontSize="14" 
                       TextColor="{StaticResource SecondaryText}" 
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,0,0,15">
                <Grid WidthRequest="110" HeightRequest="110">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding EscolherFotoCommand}"/>
                    </Grid.GestureRecognizers>

                    <Border WidthRequest="100" HeightRequest="100" StrokeShape="RoundRectangle 50" Stroke="#E5E7EB" BackgroundColor="White" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="{Binding FotoPerfil}" Aspect="AspectFill" />
                    </Border>

                    <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" Stroke="White" StrokeThickness="2" BackgroundColor="#1E40AF" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,5,5">
                        <Label Text="📷" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White"/>
                    </Border>
                </Grid>
                <Label Text="Foto de perfil (Obrigatória)*" FontFamily="InterMedium" FontSize="13" TextColor="#EF4444" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="15">
                
                <VerticalStackLayout Spacing="5">
                    <Label Text="Nome Completo" FontFamily="InterSemiBold" FontSize="14" TextColor="#1A1A1A" FontAttributes="Bold"/>
                    <Border Stroke="{StaticResource StrokeEntry}" StrokeShape="RoundRectangle 8" StrokeThickness="1" BackgroundColor="White" Padding="15,0" HeightRequest="50">
                        <Entry Placeholder="Como se chama?"
                                Text="{Binding NomeCompleto}"
                               FontFamily="InterRegular"
                               TextColor="#1A1A1A" 
                               PlaceholderColor="{StaticResource SecondaryText}"
                               VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Email" FontFamily="InterSemiBold" FontSize="14" TextColor="#1A1A1A" FontAttributes="Bold"/>
                    <Border Stroke="{StaticResource StrokeEntry}" StrokeShape="RoundRectangle 8" StrokeThickness="1" BackgroundColor="White" Padding="15,0" HeightRequest="50">
                        <Entry Placeholder="nome@example.com"
                               Keyboard="Email"
                               Text="{Binding Email}"
                               FontFamily="InterRegular"
                               TextColor="#1A1A1A" 
                               PlaceholderColor="{StaticResource SecondaryText}"
                               VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Palavra-passe" FontFamily="InterSemiBold" FontSize="14" TextColor="#1A1A1A" FontAttributes="Bold"/>
                    <Border Stroke="{StaticResource StrokeEntry}" StrokeShape="RoundRectangle 8" StrokeThickness="1" BackgroundColor="White" Padding="15,0" HeightRequest="50">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                            <Entry Placeholder="Crie uma palavra passe"
                                   x:Name="passwordEntry"
                                   Text="{Binding Password}"
                                   Grid.Column="0"
                                   IsPassword="True"
                                   FontFamily="InterRegular"
                                   TextColor="#1A1A1A" 
                                   PlaceholderColor="{StaticResource SecondaryText}"
                                   VerticalOptions="Center"/>
                            <Image Source="ico_show_password" 
                                   Grid.Column="1"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   HorizontalOptions="End" 
                                   VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnShowPasswordTapped"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Confirmar Palavra-passe" FontFamily="InterSemiBold" FontSize="14" TextColor="#1A1A1A" FontAttributes="Bold"/>
                    <Border Stroke="{StaticResource StrokeEntry}" StrokeShape="RoundRectangle 8" StrokeThickness="1" BackgroundColor="White" Padding="15,0" HeightRequest="50">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                            <Entry Placeholder="Confirme a palavra passe"
                                   x:Name="confirmPasswordEntry"
                                   Text="{Binding ConfirmPassword}"
                                   Grid.Column="0"
                                   IsPassword="True"
                                   FontFamily="InterRegular"
                                   TextColor="#1A1A1A" 
                                   PlaceholderColor="{StaticResource SecondaryText}"
                                   VerticalOptions="Center"/>
                            <Image Source="ico_show_password" 
                                   Grid.Column="1"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   HorizontalOptions="End" 
                                   VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnShowPasswordTapped"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Button Text="Continuar" 
                    BackgroundColor="{StaticResource Primary}" 
                    TextColor="White" 
                    FontFamily="InterSemiBold"
                    FontAttributes="Bold"
                    HeightRequest="50" 
                    CornerRadius="8" 
                    Margin="0, 10, 0, 0"
                    Command="{Binding RegistarCommand}"/>

            <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="15" VerticalOptions="Center" Margin="0, 5">
                <BoxView Grid.Column="0" HeightRequest="1" Color="#E0E0E0" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="Ou continue com" FontFamily="InterRegular" FontSize="12" TextColor="{StaticResource SecondaryText}" VerticalOptions="Center" />
                <BoxView Grid.Column="2" HeightRequest="1" Color="#E0E0E0" VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Spacing="15">
                <Grid HeightRequest="50">
                    <Button BackgroundColor="White" BorderColor="#E0E0E0" BorderWidth="1" CornerRadius="8" />
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" InputTransparent="True">
                        <Image Source="icon_google" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"/>
                        <Label Text="Continuar com a Google" FontFamily="InterSemiBold" FontSize="15" TextColor="#1A1A1A" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>

                <Grid HeightRequest="50">
                    <Button BackgroundColor="White" BorderColor="#E0E0E0" BorderWidth="1" CornerRadius="8" />
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" InputTransparent="True">
                        <Image Source="icon_apple" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"/>
                        <Label Text="Continuar com a Apple" FontFamily="InterSemiBold" FontSize="15" TextColor="#1A1A1A" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0, 20, 0, 0">
                <Label Text="Já tem uma conta?" FontFamily="InterRegular" FontSize="14" TextColor="{StaticResource SecondaryText}" VerticalOptions="Center"/>
                <Label Text="Entrar" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource Primary}" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackToLoginCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>