<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:CareConnect.Shared.Models;assembly=CareConnect.Shared"
             xmlns:viewmodels="clr-namespace:CareConnect.Mobile.ViewModels.Shared"
             x:Class="CareConnect.Mobile.Views.Shared.UtentesView"
             Title="Utentes"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FA">

    <Grid>
        <!-- 1. SCROLL GLOBAL DA PÁGINA (Com Pull-To-Refresh) -->
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding AtualizarListaCommand}" RefreshColor="#1E40AF">
            <ScrollView>
                
                <VerticalStackLayout>
                    
                    <!-- TOPO (CareConnect + Pesquisa) -->
                    <StackLayout Padding="20,40,20,15" Spacing="20">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                                    <Image Source="logo_careconnect.png" HeightRequest="28" />
                                    <Label Text="CareConnect" FontFamily="InterBold" FontSize="20" TextColor="#1A1A1A" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label Text="Utentes" FontSize="16" FontFamily="InterMedium" TextColor="#6B7280" Margin="40,0,0,0"/>
                            </VerticalStackLayout>

                            <Grid Grid.Column="1" WidthRequest="40" HeightRequest="40">
                                <Ellipse Fill="White" Stroke="#E0E0E0" StrokeThickness="1" WidthRequest="40" HeightRequest="40" />
                                <Image Source="icon_notification.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Ellipse Fill="#EF4444" WidthRequest="8" HeightRequest="8" HorizontalOptions="End" VerticalOptions="Start" Margin="0,8,8,0"/>
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 25" Stroke="#E5E7EB" BackgroundColor="#F9FAFB" HeightRequest="50">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Image Grid.Column="0" Source="icon_pesquisa.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" Margin="15,0,5,0"/>
                                    <Entry Grid.Column="1" 
                                           Text="{Binding TextoPesquisa}" 
                                           Placeholder="Pesquisar utentes" 
                                           PlaceholderColor="#9CA3AF" TextColor="#111827" 
                                           FontFamily="InterRegular" BackgroundColor="Transparent" 
                                           ClearButtonVisibility="WhileEditing" VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 25" Stroke="#E5E7EB" BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AlternarFiltrosCommand}"/>
                                </Border.GestureRecognizers>
                                <Image Source="icon_configuracao.png" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                    </StackLayout>

                    <!-- MENSAGEM: NADA ENCONTRADO (Só aparece se IsEmpty for true) -->
                    <VerticalStackLayout IsVisible="{Binding IsEmpty}" HorizontalOptions="Center" VerticalOptions="Center" Spacing="15" Margin="0,40,0,0">
                        <Image Source="icon_pesquisa.png" HeightRequest="45" WidthRequest="45" Opacity="0.3" HorizontalOptions="Center"/>
                        <Label Text="Nenhum utente encontrado." FontSize="16" FontFamily="InterMedium" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- LISTA DE UTENTES (Usa BindableLayout para não colapsar com o Scroll) -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ListaUtentes}" Spacing="15" Padding="20,0,20,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="shared:Patient">
                                <Border StrokeShape="RoundRectangle 15" Stroke="#E5E7EB" BackgroundColor="White" Padding="15">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:UtentesViewModel}}, Path=VerDetalhesCommand}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                        <Border Grid.Column="0" WidthRequest="60" HeightRequest="60" StrokeShape="RoundRectangle 30" StrokeThickness="0">
                                            <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" BackgroundColor="#E5E7EB"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Nome}" FontFamily="InterBold" FontSize="16" TextColor="#111827"/>
                                            <Label Text="{Binding CondicoesMedicas}" FontFamily="InterRegular" FontSize="13" TextColor="#6B7280" MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="#DEF7EC" HorizontalOptions="Start" Padding="8,4" Margin="0,5,0,0">
                                                <Label Text="Ativo" FontFamily="InterMedium" FontSize="11" TextColor="#03543F"/>
                                            </Border>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="&gt;" FontSize="20" TextColor="#9CA3AF" FontFamily="InterBold" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- ESPAÇO PARA O BOTÃO FLUTUANTE -->
                    <Grid HeightRequest="100" BackgroundColor="Transparent"/>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- 2. OVERLAY DO MENU DE FILTROS (Resolvido o bug do "risco") -->
        <Grid IsVisible="{Binding IsFiltroAberto}">
            <Grid BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding FecharFiltroCommand}"/>
                </Grid.GestureRecognizers>
            </Grid>
            
            <!-- Posicionamento absoluto logo abaixo do botão de pesquisa -->
            <Border StrokeShape="RoundRectangle 15" Stroke="#E5E7EB" BackgroundColor="White" 
                    HorizontalOptions="End" VerticalOptions="Start" 
                    WidthRequest="180" Margin="0, 160, 20, 0">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.1" Radius="10" Offset="0,4" />
                </Border.Shadow>
                
                <!-- Scroll limitador para muitas doenças e VerticalStackLayout fixo -->
                <ScrollView MaximumHeightRequest="250">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ListaDoencasFiltro}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackLayout Padding="15,12" BackgroundColor="Transparent">
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:UtentesViewModel}}, Path=SelecionarDoencaCommand}" CommandParameter="{Binding .}"/>
                                    </StackLayout.GestureRecognizers>
                                    
                                    <Label Text="{Binding .}" FontFamily="InterMedium" FontSize="14" TextColor="#111827"/>
                                    <BoxView HeightRequest="1" Color="#F3F4F6" Margin="-15,12,-15,-12" VerticalOptions="End"/>
                                </StackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- 3. BOTÃO FLUTUANTE (FAB) -->
        <Border IsVisible="{Binding IsGestor}" WidthRequest="65" HeightRequest="65" StrokeShape="RoundRectangle 32.5" StrokeThickness="0" BackgroundColor="#1E40AF" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,20,20">
            <Border.Shadow>
                <Shadow Brush="#1E40AF" Offset="0,4" Radius="10" Opacity="0.4"/>
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AdicionarUtenteCommand}"/>
            </Border.GestureRecognizers>
            <Label Text="+" FontSize="35" TextColor="White" FontFamily="InterRegular" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-5,0,0"/>
        </Border>

    </Grid>
</ContentPage>