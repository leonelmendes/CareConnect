<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CareConnect.Mobile.ViewModels.Shared"
             xmlns:models="clr-namespace:CareConnect.Mobile.Models"
             xmlns:components="clr-namespace:CareConnect.Mobile.Components"
             x:Class="CareConnect.Mobile.Views.Shared.DetalheUtenteView"
             Title="Detalhe Utente"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F9FAFB">

    <ScrollView>
        <VerticalStackLayout Padding="20,10,20,40" Spacing="25">

            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                <components:BackButton Grid.Column="0" />

                <Label Grid.Column="1" Text="Perfil do Paciente" FontFamily="InterSemiBold" FontSize="16" TextColor="#111827" HorizontalOptions="Center"/>
                <Label Grid.Column="2" Text="..." FontFamily="InterBold" FontSize="20" TextColor="#1E40AF"/>
            </Grid>

            <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                <Border WidthRequest="100" HeightRequest="100" StrokeShape="RoundRectangle 50" StrokeThickness="0" BackgroundColor="#E5E7EB" HorizontalOptions="Center">
                    <Image Source="{Binding UtenteRecebido.FotoUrl}" Aspect="AspectFill" />
                </Border>
                <Label Text="{Binding UtenteRecebido.Nome}" FontFamily="InterBold" FontSize="20" TextColor="#111827" HorizontalOptions="Center" Margin="0,10,0,0"/>
                <Label Text="{Binding UtenteRecebido.Idade, StringFormat='{0} anos'}" FontFamily="InterRegular" FontSize="14" TextColor="#6B7280" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="30" Margin="0,10,0,10">

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Border WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 25" Stroke="#E5E7EB" BackgroundColor="White">
                        <Label Text="📞" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="Ligar" FontSize="12" FontFamily="InterMedium" TextColor="#6B7280" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Border WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 25" Stroke="#FECACA" BackgroundColor="#FEF2F2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LigarEmergenciaCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="🚨" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="Emergência" FontSize="12" FontFamily="InterMedium" TextColor="#EF4444" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center" IsVisible="{Binding IsGestor}">
                    <Border WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 25" Stroke="#E5E7EB" BackgroundColor="White">
                        <Label Text="✏️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="Editar" FontSize="12" FontFamily="InterMedium" TextColor="#6B7280" HorizontalOptions="Center"/>
                </VerticalStackLayout>

            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Condições Médicas" FontFamily="InterBold" FontSize="16" TextColor="#111827" Margin="5,0,0,0"/>
                <Border StrokeShape="RoundRectangle 15" Stroke="#E5E7EB" BackgroundColor="White" Padding="15,5">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Condicoes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CondicaoMedica">
                                <Grid ColumnDefinitions="Auto, *, Auto" Padding="0,15" RowDefinitions="Auto,Auto">
                                    <BoxView Grid.Row="0" Grid.ColumnSpan="3" HeightRequest="1" Color="#F3F4F6" VerticalOptions="Start" Margin="0,-15,0,10" IsVisible="{Binding Nome, Converter={x:Static StringToNullConverter}}" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Icone}" FontSize="24" VerticalOptions="Center" Margin="0,0,15,0"/>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Nome}" FontFamily="InterSemiBold" FontSize="15" TextColor="#111827"/>
                                        <Label Text="{Binding DataDiagnostico, StringFormat='Diagnosticado: {0}'}" FontFamily="InterRegular" FontSize="12" TextColor="#6B7280"/>
                                    </VerticalStackLayout>

                                    <Border Grid.Row="1" Grid.Column="2" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{Binding CorFundoStatus}" VerticalOptions="Center" Padding="8,4">
                                        <Label Text="{Binding Status}" FontFamily="InterMedium" FontSize="11" TextColor="{Binding CorTextoStatus}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*, Auto" Margin="5,0,5,0">
                    <Label Grid.Column="0" Text="Cuidadores Atribuídos" FontFamily="InterBold" FontSize="16" TextColor="#111827" VerticalOptions="Center"/>

                    <Label Grid.Column="1" Text="Gerir Cuidadores" FontFamily="InterMedium" FontSize="14" TextColor="#1E40AF" VerticalOptions="Center" IsVisible="{Binding IsGestor}"/>
                </Grid>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Cuidadores}" Spacing="15" Padding="5,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CuidadorAtribuido">
                                <VerticalStackLayout Spacing="5" HorizontalOptions="Center" WidthRequest="90">
                                    <Border WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 25" StrokeThickness="0" BackgroundColor="#E5E7EB" HorizontalOptions="Center">
                                        <Image Source="{Binding FotoUrl}" Aspect="AspectFill" />
                                    </Border>
                                    <Label Text="{Binding Nome}" FontFamily="InterSemiBold" FontSize="13" TextColor="#111827" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Cargo}" FontFamily="InterRegular" FontSize="11" TextColor="#6B7280" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>