<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CareConnect.Mobile.ViewModels.Shared"
             x:Class="CareConnect.Mobile.Views.Shared.PerfilView"
             Title="Perfil"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F9FAFB">

    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,30" Spacing="25">

            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                
                <Grid WidthRequest="110" HeightRequest="110" HorizontalOptions="Center">
                    <Border Stroke="#2563EB" StrokeThickness="3" StrokeShape="RoundRectangle 55" 
                            WidthRequest="110" HeightRequest="110" Padding="3"
                            Shadow="{Shadow Brush=#2563EB, Offset='0,4', Radius=12, Opacity=0.3}">
                        <Image Source="{Binding AvatarUrl, TargetNullValue='avatar_elderly.png', FallbackValue='avatar_elderly.png'}" 
                               Aspect="AspectFill" />
                    </Border>
                </Grid>

                <Label Text="{Binding Nome}" 
                       FontFamily="InterBold" FontSize="22" FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" 
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />

                <Label Text="{Binding Email}" 
                       FontFamily="InterRegular" FontSize="14" 
                       TextColor="#6B7280" 
                       HorizontalOptions="Center" Margin="0,-6,0,0" />

                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" 
                        BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E3A8A}" 
                        Padding="14,6" HorizontalOptions="Center" Margin="0,4,0,0">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="🛡️" FontSize="14" VerticalOptions="Center"/>
                        <Label Text="{Binding Perfil}" 
                               FontFamily="InterSemiBold" FontSize="13" FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#BFDBFE}" 
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 15" Stroke="#E5E7EB" BackgroundColor="White" Margin="0,10,0,0">
                <VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,15">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavegarMenuCommand}" CommandParameter="Editar Perfil"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="👤" FontSize="20" VerticalOptions="Center" Margin="0,0,15,0"/>
                        <Label Grid.Column="1" Text="Editar Perfil" FontFamily="InterSemiBold" FontSize="15" TextColor="#374151" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="&gt;" FontFamily="InterBold" FontSize="16" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F3F4F6"/>

                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,15">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavegarMenuCommand}" CommandParameter="Notificações"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="🔔" FontSize="20" VerticalOptions="Center" Margin="0,0,15,0"/>
                        <Label Grid.Column="1" Text="Notificações" FontFamily="InterSemiBold" FontSize="15" TextColor="#374151" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="&gt;" FontFamily="InterBold" FontSize="16" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F3F4F6"/>

                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,15" IsVisible="{Binding IsGestor}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavegarMenuCommand}" CommandParameter="Gerir Cuidadores"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="👥" FontSize="20" VerticalOptions="Center" Margin="0,0,15,0"/>
                        <Label Grid.Column="1" Text="Gerir Cuidadores" FontFamily="InterSemiBold" FontSize="15" TextColor="#374151" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="&gt;" FontFamily="InterBold" FontSize="16" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F3F4F6" IsVisible="{Binding IsGestor}"/>

                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,15">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavegarMenuCommand}" CommandParameter="Segurança"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="🛡️" FontSize="20" VerticalOptions="Center" Margin="0,0,15,0"/>
                        <Label Grid.Column="1" Text="Segurança" FontFamily="InterSemiBold" FontSize="15" TextColor="#374151" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="&gt;" FontFamily="InterBold" FontSize="16" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F3F4F6"/>

                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,15">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavegarMenuCommand}" CommandParameter="Privacidade"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="🔒" FontSize="20" VerticalOptions="Center" Margin="0,0,15,0"/>
                        <Label Grid.Column="1" Text="Privacidade" FontFamily="InterSemiBold" FontSize="15" TextColor="#374151" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="&gt;" FontFamily="InterBold" FontSize="16" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F3F4F6"/>

                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,15">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavegarMenuCommand}" CommandParameter="Sobre o CareConnect"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="ℹ️" FontSize="20" VerticalOptions="Center" Margin="0,0,15,0"/>
                        <Label Grid.Column="1" Text="Sobre o CareConnect" FontFamily="InterSemiBold" FontSize="15" TextColor="#374151" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="&gt;" FontFamily="InterBold" FontSize="16" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E5E7EB, Dark=#2D3748}" Margin="0,10" />

            <VerticalStackLayout Spacing="12">
                <Label Text="Definições e Aparência" FontFamily="InterBold" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#374151, Dark=#E2E8F0}"/>
                
                <Border Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2D3748}" StrokeThickness="1" 
                        StrokeShape="RoundRectangle 16" 
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A202C}" 
                        Padding="16">
                    
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0" BackgroundColor="#F3E8FF" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="42" HeightRequest="42">
                            <Label Text="🌙" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Modo Escuro" FontFamily="InterSemiBold" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F7FAFC}"/>
                            <Label Text="Alterar o tema visual da aplicação" FontFamily="InterRegular" FontSize="12" TextColor="#6B7280"/>
                        </VerticalStackLayout>

                        <Switch Grid.Column="2" 
                                IsToggled="{Binding IsDarkMode}" 
                                OnColor="#2563EB" 
                                ThumbColor="White" 
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Button Text="🚪  Terminar Sessão" 
                    Command="{Binding TerminarSessaoCommand}"
                    BackgroundColor="#FEF2F2" 
                    TextColor="#DC2626" 
                    BorderColor="#FECACA"
                    BorderWidth="1"
                    FontFamily="InterBold" FontSize="15" FontAttributes="Bold"
                    CornerRadius="14" HeightRequest="52" Margin="0,20,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>