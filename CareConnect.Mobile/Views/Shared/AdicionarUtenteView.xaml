<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CareConnect.Mobile.ViewModels.Gestor"
             xmlns:components="clr-namespace:CareConnect.Mobile.Components"
             x:Class="CareConnect.Mobile.Views.Shared.AdicionarUtenteView"
             Title="Adicionar Utente"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F4F7FA">

    <Grid>
        <ScrollView IsVisible="{Binding IsNotLoading}">
            <VerticalStackLayout Padding="20,10,20,40" Spacing="25">

                <!-- CABEÇALHO -->
                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                    <components:BackButton Grid.Column="0" />
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                        <Label Text="Novo Utente" FontFamily="InterBold" FontSize="18" TextColor="#111827" HorizontalOptions="Center"/>
                        <Label Text="Ficha de Registo" FontFamily="InterRegular" FontSize="12" TextColor="#6B7280" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- FOTO DE PERFIL -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Grid WidthRequest="110" HeightRequest="110">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EscolherFotoCommand}"/>
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="100" HeightRequest="100" StrokeShape="RoundRectangle 50" Stroke="#E5E7EB" BackgroundColor="White" HorizontalOptions="Center" VerticalOptions="Center" >
                            <Image Source="{Binding FotoCaminho}" Aspect="AspectFill" />
                        </Border>
                        <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" Stroke="White" StrokeThickness="2" BackgroundColor="#1E40AF" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,5,5">
                            <Image Source="icon_camera.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                    <Label Text="Foto de perfil" FontFamily="InterMedium" FontSize="14" TextColor="#6B7280" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- CARTÃO 1: DADOS PESSOAIS -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="DADOS PESSOAIS" FontFamily="InterBold" FontSize="12" TextColor="#6B7280" Margin="5,0,0,0"/>
                    <Border StrokeShape="RoundRectangle 16" Stroke="#E5E7EB" BackgroundColor="White" Padding="15,5">
                        <VerticalStackLayout Spacing="0">
                            <!-- Nome -->
                            <Grid ColumnDefinitions="*, Auto" HeightRequest="50">
                                <Entry Grid.Column="0" Text="{Binding NomeCompleto}" Placeholder="Nome Completo" FontFamily="InterRegular" FontSize="15" TextColor="#111827" BackgroundColor="Transparent"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F3F4F6"/>
                            <!-- Idade -->
                            <Grid ColumnDefinitions="*, Auto" HeightRequest="50">
                                <Label Grid.Column="0" Text="Idade (Anos)" FontFamily="InterRegular" FontSize="15" TextColor="#111827" VerticalOptions="Center"/>
                                <HorizontalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Center">
                                    <Label Text="-" FontSize="24" TextColor="#1E40AF" VerticalOptions="Center" FontAttributes="Bold">
                                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding DiminuirIdadeCommand}"/></Label.GestureRecognizers>
                                    </Label>
                                    <Entry Keyboard="Numeric" Text="{Binding Idade}" FontFamily="InterSemiBold" FontSize="16" TextColor="#111827" VerticalOptions="Center" WidthRequest="30" HorizontalTextAlignment="Center"/>
                                    <Label Text="+" FontSize="24" TextColor="#1E40AF" VerticalOptions="Center" FontAttributes="Bold">
                                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding AumentarIdadeCommand}"/></Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- CARTÃO 2: CONTACTOS -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="CONTACTOS" FontFamily="InterBold" FontSize="12" TextColor="#6B7280" Margin="5,0,0,0"/>
                    <Border StrokeShape="RoundRectangle 16" Stroke="#E5E7EB" BackgroundColor="White" Padding="15,5">
                        <VerticalStackLayout Spacing="0">
                            <Grid HeightRequest="50">
                                <Entry Text="{Binding Contacto}" Keyboard="Telephone" Placeholder="Telemóvel do Utente (Opcional)" FontFamily="InterRegular" FontSize="15" TextColor="#111827" BackgroundColor="Transparent"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F3F4F6"/>
                            <Grid HeightRequest="50">
                                <Entry Text="{Binding ContactoEmergencia}" Keyboard="Telephone" Placeholder="Contacto de Emergência" FontFamily="InterRegular" FontSize="15" TextColor="#111827" BackgroundColor="Transparent"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- CARTÃO 3: PERFIL CLÍNICO -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="PERFIL CLÍNICO" FontFamily="InterBold" FontSize="12" TextColor="#6B7280" Margin="5,0,0,0"/>
                    <Border StrokeShape="RoundRectangle 16" Stroke="#E5E7EB" BackgroundColor="White" Padding="15,5">
                        <VerticalStackLayout Spacing="0">
                            <Grid HeightRequest="50">
                                <Picker ItemsSource="{Binding CondicoesDisponiveis}" SelectedItem="{Binding CondicaoSelecionada}" Title="Condição Médica Principal" FontFamily="InterRegular" FontSize="15" TextColor="#111827" TitleColor="#9CA3AF" BackgroundColor="Transparent" HorizontalOptions="FillAndExpand"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F3F4F6"/>
                            <Grid HeightRequest="50">
                                <Entry Text="{Binding Alergias}" Placeholder="Alergias (Ex: Penicilina)" FontFamily="InterRegular" FontSize="15" TextColor="#111827" BackgroundColor="Transparent"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- CARTÃO 4: EQUIPA -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="ATRIBUIÇÃO INICIAL" FontFamily="InterBold" FontSize="12" TextColor="#6B7280" Margin="5,0,0,0"/>
                    <Border StrokeShape="RoundRectangle 16" Stroke="#E5E7EB" BackgroundColor="White" Padding="15,5">
                        <Grid HeightRequest="50">
                            <Picker ItemsSource="{Binding CuidadoresDisponiveis}" SelectedItem="{Binding CuidadorSelecionado}" ItemDisplayBinding="{Binding Nome}" Title="Atribuir Cuidador Principal" FontFamily="InterRegular" FontSize="15" TextColor="#111827" TitleColor="#9CA3AF" BackgroundColor="Transparent" HorizontalOptions="FillAndExpand"/>
                        </Grid>
                    </Border>
                    <Label Text="Poderá criar os Planos de Cuidados (CarePlans) e agendar tarefas após o registo do utente." FontFamily="InterRegular" FontSize="11" TextColor="#9CA3AF" Margin="5,2,0,0"/>
                </VerticalStackLayout>

                <!-- BOTÃO DE GUARDAR -->
                <Button Text="Gravar Ficha de Utente" Command="{Binding GuardarUtenteCommand}" IsEnabled="{Binding IsNotLoading}" HeightRequest="55" CornerRadius="14" BackgroundColor="#1E40AF" TextColor="White" FontFamily="InterBold" FontSize="16" Margin="0,15,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- OVERLAY DE CARREGAMENTO -->
        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsLoading}" SafeAreaEdges="None" ZIndex="999">
            <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" WidthRequest="140" HeightRequest="140" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                    <ActivityIndicator IsRunning="{Binding IsLoading}" Color="#1E40AF" WidthRequest="40" HeightRequest="40" />
                    <Label Text="A gravar..." TextColor="#4B5563" FontSize="14" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>