<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:CareConnect.Mobile.Components"
             xmlns:vm="clr-namespace:CareConnect.Mobile.ViewModels.Gestor"
             x:Class="CareConnect.Mobile.Views.Gestor.DetalhePlanoView"
             x:DataType="vm:DetalhePlanoViewModel"
             Title="Detalhe do Plano"
             BackgroundColor="#F9FAFB"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,40,20,30" Spacing="25">

                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                    <components:BackButton Grid.Column="0" />
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                        <Label Text="Edição de Rotina" FontFamily="InterBold" FontSize="18" TextColor="#111827" HorizontalOptions="Center"/>
                        <Label Text="{Binding TipoPlano, StringFormat='Categoria: {0}'}" FontFamily="InterRegular" FontSize="12" TextColor="#6B7280" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="8">
                    <Label Text="PERTENCE A" FontFamily="InterBold" FontSize="12" TextColor="#6B7280" Margin="5,0,0,0"/>
                    <Border StrokeShape="RoundRectangle 16" Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" Padding="16">
                        <Grid ColumnDefinitions="50,*" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Grid.Column="0" WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 25" StrokeThickness="0">
                                <Image Source="{Binding FotoUtente}" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Utente Atribuído" FontSize="11" TextColor="#3B82F6" FontAttributes="Bold" />
                                <Label Text="{Binding NomeUtente}" FontSize="16" FontAttributes="Bold" TextColor="#1F2937" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="15">
                    <Label Text="DADOS DO PLANO (EDITÁVEIS)" FontFamily="InterBold" FontSize="12" TextColor="#6B7280" Margin="5,0,0,0"/>
                    
                    <Border StrokeShape="RoundRectangle 12" Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" Padding="12,4" HeightRequest="100">
                        <Editor Text="{Binding DescricaoEditada}" 
                                Placeholder="Descrição da Tarefa"
                                TextColor="#1F2937" 
                                VerticalOptions="Fill" />
                    </Border>

                    <Border StrokeShape="RoundRectangle 12" Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" HeightRequest="55" Padding="15,0">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Hora de Execução" FontSize="15" TextColor="#374151" VerticalOptions="Center" />
                            <TimePicker Grid.Column="1" Time="{Binding HoraEditada}" TextColor="#1D4ED8" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" Margin="0,15,0,0">
                    <Button Text="💾  Gravar Alterações" 
                            Command="{Binding GuardarAlteracoesCommand}" 
                            CornerRadius="14" HeightRequest="55" 
                            BackgroundColor="#1D4ED8" TextColor="White" FontSize="16" FontAttributes="Bold" />
                    
                    <Button Text="🗑️  Apagar este Plano" 
                            Command="{Binding ApagarPlanoCommand}" 
                            CornerRadius="14" HeightRequest="55" 
                            BackgroundColor="#FEF2F2" TextColor="#EF4444" BorderColor="#FECACA" BorderWidth="1" FontSize="16" FontAttributes="Bold" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>