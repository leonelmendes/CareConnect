<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CareConnect.Mobile.Views.Gestor.RelatorioDiarioView"
             Title="Relatório Diário"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- CABEÇALHO DO RELATÓRIO E FILTRO DE DATA -->
            <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Text="Data do Relatório" FontFamily="InterSemiBold" FontSize="14" TextColor="#64748B"/>
                        <DatePicker Grid.Column="1" Date="{Binding DataRelatorio}" TextColor="#1A1A1A" FontFamily="InterBold"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E2E8F0" />

                    <!-- DADOS DOS INTERVENIENTES -->
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *" RowSpacing="10" ColumnSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Utente:" FontFamily="InterSemiBold" TextColor="#64748B"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding NomeUtente}" FontFamily="InterBold" TextColor="#1A1A1A"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Cuidador(a):" FontFamily="InterSemiBold" TextColor="#64748B"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding NomeCuidadorResponsavel}" FontFamily="InterBold" TextColor="#3B82F6"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ESTATÍSTICAS RÁPIDAS -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                <Border Grid.Column="0" BackgroundColor="#DCFCE7" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Concluídas" FontSize="12" TextColor="#166534"/>
                        <Label Text="{Binding TotalConcluidas}" FontSize="24" FontFamily="InterBold" TextColor="#15803D"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#FEE2E2" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Pendentes" FontSize="12" TextColor="#991B1B"/>
                        <Label Text="{Binding TotalPendentes}" FontSize="24" FontFamily="InterBold" TextColor="#B91C1C"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- LISTAGEM DE TAREFAS (Usa a mesma estrutura visual limpa que já criaste) -->
            <Label Text="Detalhe das Tarefas" FontFamily="InterBold" FontSize="18" TextColor="#1A1A1A" Margin="0,10,0,0"/>

            <CollectionView ItemsSource="{Binding TarefasDoRelatorio}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- AQUI COLOCAS A EXATA MESMA BORDER QUE USAMOS NO HISTÓRICO DO CUIDADOR -->
                        <!-- Com a barra lateral verde/vermelha/roxa, título, hora prevista e hora de conclusão -->
                        <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="4, *, Auto" ColumnSpacing="12">
                                <BoxView Grid.Column="0" BackgroundColor="{Binding CorStatus}" CornerRadius="2" />
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="{Binding TextoStatus}" TextColor="{Binding CorStatus}" FontSize="11" FontAttributes="Bold" />
                                    <Label Text="{Binding Titulo}" FontFamily="InterBold" FontSize="15" TextColor="#1A1A1A" />
                                    <Label Text="{Binding HoraConclusaoFormatada, StringFormat='Feito às: {0}'}" FontSize="12" TextColor="#64748B" IsVisible="{Binding EstaConcluida}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Exportar e Partilhar PDF" 
                    Command="{Binding PartilharRelatorioPdfCommand}" 
                    BackgroundColor="#3B82F6" 
                    TextColor="White" 
                    CornerRadius="8" 
                    FontFamily="InterBold"
                    Margin="0,10,0,20"/>

        </VerticalStackLayout>
        
    </ScrollView>
</ContentPage>