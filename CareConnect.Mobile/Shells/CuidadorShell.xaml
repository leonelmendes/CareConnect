<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CareConnect.Mobile.Shells.CuidadorShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.FlyoutBehavior="Disabled">

    <!-- TabBar exclusivo para Operação Diária -->
    <TabBar>
        <Tab Title="Agenda">
            <ShellContent>
                <ContentPage Title="A Minha Agenda" BackgroundColor="#FAFAFA" />
            </ShellContent>
        </Tab>
        <Tab Title="Utentes">
            <ShellContent>
                <ContentPage Title="Consulta de Utentes" BackgroundColor="#FAFAFA" />
            </ShellContent>
        </Tab>
        <Tab Title="Tarefas">
            <ShellContent>
                <ContentPage Title="Histórico de Tarefas" BackgroundColor="#FAFAFA" />
            </ShellContent>
        </Tab>
        <Tab Title="Perfil">
            <ShellContent>
                <ContentPage Title="O Meu Perfil" BackgroundColor="#FAFAFA" />
            </ShellContent>
        </Tab>
    </TabBar>
</Shell>