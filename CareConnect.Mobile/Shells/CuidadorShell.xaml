<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CareConnect.Mobile.Shells.CuidadorShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CareConnect.Mobile.Views.Cuidador"
    Shell.NavBarIsVisible="False" 
    NavigationPage.HasNavigationBar="False"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Dashboard" Icon="icon_home.png">
            <ShellContent ContentTemplate="{DataTemplate views:CuidadorHomeView}" />
        </Tab>
        
        <Tab Title="Pacientes" Icon="icon_utentes.png">
        </Tab>
        
        <Tab Title="Tarefas" Icon="icon_tarefas.png">
        </Tab>
        
        <Tab Title="Perfil" Icon="icon_perfil.png">
        </Tab>
    </TabBar>
</Shell>