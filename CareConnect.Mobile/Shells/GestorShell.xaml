<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CareConnect.Mobile.Shells.GestorShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:gestor="clr-namespace:CareConnect.Mobile.Views.Gestor"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False" 
    NavigationPage.HasNavigationBar="False"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        
        <Tab Title="Início">
            <ShellContent ContentTemplate="{DataTemplate gestor:GestorHomeView}" />
        </Tab>
        
        <Tab Title="Utentes">
            <ShellContent ContentTemplate="{DataTemplate gestor:PatientFormView}" />
        </Tab>
        
        <Tab Title="Planos">
            <ShellContent ContentTemplate="{DataTemplate gestor:CarePlanListView}" />
        </Tab>
        
        <Tab Title="Perfil">
            <ShellContent>
                <ContentPage Title="O Meu Perfil" BackgroundColor="#FAFAFA" />
            </ShellContent>
        </Tab>
        
    </TabBar>
</Shell>