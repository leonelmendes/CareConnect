<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CareConnect.Mobile.Shells.GestorShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:gestor="clr-namespace:CareConnect.Mobile.Views.Gestor"
    xmlns:shared="clr-namespace:CareConnect.Mobile.Views.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False" 
    NavigationPage.HasNavigationBar="False"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        
        <Tab Title="Início" Icon="icon_inicio">
            <ShellContent ContentTemplate="{DataTemplate gestor:GestorHomeView}" />
        </Tab>
        
        <Tab Title="Utentes" Icon="icon_utentes">
            <ShellContent ContentTemplate="{DataTemplate shared:UtentesView}" />
        </Tab>
        
        <Tab Title="Planos" Icon="icon_planos.png">
            <ShellContent ContentTemplate="{DataTemplate gestor:GestorPlanosView}" />
        </Tab>
        
        <Tab Title="Perfil" Icon="icon_perfil.png">
            <ShellContent ContentTemplate="{DataTemplate shared:PerfilView}"/>
        </Tab>
        
    </TabBar>
</Shell>